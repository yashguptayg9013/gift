{
  "name": "puja-os",
  "version": "1.0.0",
  "private": true,
  "description": "PUJA OS — manufacturing operating system for notebook, diary and PU leather goods manufacturing",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r --filter @puja/shared build && pnpm --filter @puja/api build && pnpm --filter @puja/web build",
    "build:shared": "pnpm --filter @puja/shared build",
    "dev:api": "pnpm --filter @puja/api start:dev",
    "dev:web": "pnpm --filter @puja/web dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm --filter @puja/shared test && pnpm --filter @puja/api test",
    "test:e2e": "pnpm --filter @puja/web test:e2e",
    "db:migrate": "pnpm --filter @puja/api prisma:migrate",
    "db:seed": "pnpm --filter @puja/api db:seed"
  }
}
