# ─────────────────────────────────────────────────────────────────────────────
# PUJA OS environment configuration. Copy to `.env` (docker compose) or
# `apps/api/.env` (local API). NEVER commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production                 # development | test | staging | production
PORT=4000                           # API port
APP_URL=https://erp.example.com     # public web URL (used in emails/links)
CORS_ORIGINS=https://erp.example.com # comma-separated browser origins allowed (also CSRF origin check)
TRUST_PROXY=true                    # true when behind a reverse proxy / load balancer
LOG_LEVEL=info

# ── Database (PostgreSQL 16) ─────────────────────────────────────────────────
POSTGRES_DB=puja_os
POSTGRES_USER=puja
POSTGRES_PASSWORD=                  # REQUIRED (docker compose)
# Local API only (compose builds this automatically):
# DATABASE_URL=postgresql://puja:<password>@localhost:5432/puja_os?schema=public

# ── Redis / background jobs (BullMQ) ─────────────────────────────────────────
REDIS_PASSWORD=                     # REQUIRED (docker compose)
# REDIS_URL=redis://:<password>@localhost:6379
JOBS_ENABLED=true                   # false = deliver notifications inline, no schedulers

# ── Authentication ───────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=                  # REQUIRED, ≥ 32 random chars: openssl rand -base64 48
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=14
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# COOKIE_SECURE=true                # defaults to true in production

# First administrator — created by the bootstrap seed only when no users exist.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=           # ≥ 12 chars, letters and digits; change after first login
BOOTSTRAP_ADMIN_NAME=Administrator

# ── File storage ─────────────────────────────────────────────────────────────
STORAGE_DRIVER=s3                   # local | s3
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=                        # e.g. http://minio:9000 (omit for AWS S3)
S3_REGION=ap-south-1
S3_BUCKET=puja-files
S3_ACCESS_KEY_ID=                   # REQUIRED for s3 (also MinIO root user in compose)
S3_SECRET_ACCESS_KEY=               # REQUIRED for s3
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_BYTES=5242880

# ── Email (optional; without it emails are logged, not sent) ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=                          # e.g. "PUJA OS <erp@example.com>"

# ── WhatsApp Cloud API (optional) ────────────────────────────────────────────
WHATSAPP_API_URL=https://graph.facebook.com/v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=             # approved template with one body parameter

# ── AI Copilot (optional; without a key the copilot reports "not configured") ─
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
AI_EFFORT=medium                    # low | medium | high | xhigh | max
AI_MAX_TOOL_STEPS=8
AI_MAX_TOKENS=16000

# ── Monitoring (optional) ────────────────────────────────────────────────────
SENTRY_DSN=                         # requires `pnpm --filter @puja/api add @sentry/node`
SWAGGER_ENABLED=false               # expose /api/docs in production

# ── Deployment ───────────────────────────────────────────────────────────────
WEB_PORT=3000
BACKUP_RETENTION_DAYS=30
BACKUP_HOUR=23                      # container local time (UTC unless TZ is set)
RUN_MIGRATIONS=true
RUN_BOOTSTRAP_SEED=true
