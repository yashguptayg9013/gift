// PUJA OS — database schema
// Conventions:
//   * ids are cuid strings; human-facing document numbers come from DocumentSequence
//   * quantities are Decimal(18,4) in the item's base unit; money is Decimal(14,2) INR
//   * stock is changed ONLY through InventoryTransaction + StockMovement (ledger);
//     StockBalance is a cache maintained in the same DB transaction.
//   * see DATABASE_SCHEMA.md for the narrative description

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────────── Identity & access ─────────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  name              String
  phone             String?
  passwordHash      String
  isActive          Boolean   @default(true)
  failedLoginCount  Int       @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  passwordChangedAt DateTime  @default(now())
  /// incremented whenever roles/permissions change → forces token permission refresh
  permissionVersion Int       @default(1)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  roles               UserRole[]
  sessions            Session[]
  resetTokens         PasswordResetToken[]
  worker              Worker?
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  aiConversations     AiConversation[]
  auditLogs           AuditLog[]               @relation("AuditActor")
  approvalsRequested  ApprovalRequest[]        @relation("ApprovalRequester")
  approvalsDecided    ApprovalRequest[]        @relation("ApprovalDecider")
  inspectionsAssigned QualityInspection[]      @relation("Inspector")
}

model Role {
  id          String           @id @default(cuid())
  key         String           @unique
  name        String
  description String?
  isSystem    Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  permissions RolePermission[]
  users       UserRole[]
}

model RolePermission {
  roleId     String
  permission String
  role       Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permission])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
}

model Session {
  id               String    @id @default(cuid())
  userId           String
  refreshTokenHash String    @unique
  /// hash of the previous (rotated) refresh token — reuse triggers revocation
  previousHash     String?   @unique
  userAgent        String?
  ip               String?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  revokedReason    String?
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum ActorType {
  USER
  AI
  SYSTEM
}

model AuditLog {
  id         String    @id @default(cuid())
  actorType  ActorType @default(USER)
  actorId    String?
  actor      User?     @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  summary    String?
  before     Json?
  after      Json?
  metadata   Json?
  requestId  String?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
}

enum ApprovalType {
  STOCK_ADJUSTMENT
  STOCK_COUNT
  REJECTED_STOCK_RELEASE
  AI_ACTION
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXECUTED
  FAILED
  CANCELLED
}

/// Generic approval inbox: stock adjustments above threshold, AI-proposed actions, etc.
model ApprovalRequest {
  id                 String         @id @default(cuid())
  number             String         @unique
  type               ApprovalType
  status             ApprovalStatus @default(PENDING)
  title              String
  description        String?
  /// validated command payload that will be executed on approval
  payload            Json
  /// permission the approver must hold
  requiredPermission String
  requestedById      String
  requestedBy        User           @relation("ApprovalRequester", fields: [requestedById], references: [id])
  requestedVia       ActorType      @default(USER)
  decidedById        String?
  decidedBy          User?          @relation("ApprovalDecider", fields: [decidedById], references: [id])
  decidedAt          DateTime?
  decisionNote       String?
  executedAt         DateTime?
  resultEntityType   String?
  resultEntityId     String?
  error              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status, type])
}

// ───────────────────────────── Settings & numbering ─────────────────────────────

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model DocumentSequence {
  key         String  @id
  prefix      String
  nextValue   Int     @default(1)
  padding     Int     @default(5)
  /// when true the counter restarts each financial year (April) and the year is embedded
  resetYearly Boolean @default(true)
  periodKey   String?
}

model FileObject {
  id           String   @id @default(cuid())
  storageKey   String   @unique
  filename     String
  mimeType     String
  size         Int
  sha256       String
  entityType   String?
  entityId     String?
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([entityType, entityId])
}

// ───────────────────────────── Locations & units ─────────────────────────────

model Warehouse {
  id                 String     @id @default(cuid())
  code               String     @unique
  name               String
  address            String?
  isActive           Boolean    @default(true)
  allowNegativeStock Boolean    @default(false)
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  locations          Location[]
}

enum LocationType {
  STORAGE
  RECEIVING
  QC_HOLD
  REJECTED
  PRODUCTION
  DISPATCH
}

model Location {
  id          String       @id @default(cuid())
  warehouseId String
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id])
  code        String
  name        String
  type        LocationType @default(STORAGE)
  isActive    Boolean      @default(true)
  isDefault   Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  balances     StockBalance[]
  movements    StockMovement[]
  reservations StockReservation[]

  @@unique([warehouseId, code])
}

enum UomDimension {
  COUNT
  LENGTH
  AREA
  WEIGHT
  VOLUME
}

model Uom {
  id        String       @id @default(cuid())
  code      String       @unique
  name      String
  dimension UomDimension
  /// number of decimal places allowed for quantities in this unit
  precision Int          @default(0)
  isActive  Boolean      @default(true)
  items     Item[]
}

// ───────────────────────────── Items (materials & finished goods) ─────────────────────────────

enum ItemType {
  MATERIAL
  PRODUCT
}

model ItemCategory {
  id              String         @id @default(cuid())
  type            ItemType
  code            String         @unique
  name            String
  description     String?
  parentId        String?
  parent          ItemCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children        ItemCategory[] @relation("CategoryTree")
  /// attribute definitions: [{ key, label, type: number|text|select, unit?, options?, required? }]
  attributeSchema Json           @default("[]")
  defaultUomId    String?
  isActive        Boolean        @default(true)
  sortOrder       Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  items           Item[]
  products        Product[]
}

enum ProductStatus {
  DRAFT
  ACTIVE
  DISCONTINUED
}

/// Product template grouping finished-goods variants (each variant is an Item of type PRODUCT)
model Product {
  id                 String        @id @default(cuid())
  code               String        @unique
  name               String
  categoryId         String?
  category           ItemCategory? @relation(fields: [categoryId], references: [id])
  description        String?
  manufacturingSpecs String?
  imageFileId        String?
  status             ProductStatus @default(ACTIVE)
  defaultRouteId     String?
  defaultRoute       Route?        @relation(fields: [defaultRouteId], references: [id])
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  variants           Item[]
}

model Item {
  id                 String        @id @default(cuid())
  type               ItemType
  /// material code or SKU
  code               String        @unique
  name               String
  description        String?
  categoryId         String?
  category           ItemCategory? @relation(fields: [categoryId], references: [id])
  uomId              String
  uom                Uom           @relation(fields: [uomId], references: [id])
  /// category-schema driven attributes (thickness_mm, colour, length_mm, ...)
  attributes         Json          @default("{}")
  specifications     String?
  colour             String?
  /// product variant fields
  productId          String?
  product            Product?      @relation(fields: [productId], references: [id])
  variantName        String?
  dimensions         String?
  imageFileId        String?
  routeId            String?
  route              Route?        @relation(fields: [routeId], references: [id])
  status             ProductStatus @default(ACTIVE)
  /// stock policy
  minStock           Decimal       @default(0) @db.Decimal(18, 4)
  reorderLevel       Decimal       @default(0) @db.Decimal(18, 4)
  reorderQty         Decimal       @default(0) @db.Decimal(18, 4)
  trackBatches       Boolean       @default(false)
  requiresInspection Boolean       @default(false)
  /// pricing (INR)
  standardCost       Decimal?      @db.Decimal(14, 2)
  lastPurchasePrice  Decimal?      @db.Decimal(14, 2)
  sellingPrice       Decimal?      @db.Decimal(14, 2)
  taxRate            Decimal?      @db.Decimal(5, 2)
  hsnCode            String?
  defaultSupplierId  String?
  defaultLocationId  String?
  remarks            String?
  isActive           Boolean       @default(true)
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  uomConversions      ItemUomConversion[]
  batches             Batch[]
  balances            StockBalance[]
  movements           StockMovement[]
  reservations        StockReservation[]
  bom                 Bom?
  bomLines            BomLine[]
  bomAlternatives     BomLineAlternative[]
  supplierItems       SupplierItem[]
  customerPrices      CustomerPrice[]
  productionOrders    ProductionOrder[]         @relation("ProductionOrderItem")
  productionMaterials ProductionMaterial[]      @relation("ProductionMaterialItem")
  inspections         QualityInspection[]       @relation("InspectionItem")
  poLines             PurchaseOrderLine[]       @relation("PoLineItem")
  grnLines            GoodsReceiptLine[]        @relation("GrnLineItem")
  supplierReturnLines SupplierReturnLine[]      @relation("SupplierReturnLineItem")
  quotationLines      QuotationLine[]           @relation("QuotationLineItem")
  salesOrderLines     SalesOrderLine[]          @relation("SoLineItem")
  challanLines        DeliveryChallanLine[]     @relation("ChallanLineItem")
  requisitionLines    PurchaseRequisitionLine[] @relation("RequisitionLineItem")

  @@index([type, isActive])
  @@index([productId])
  @@index([categoryId])
}

/// Per-item conversion, e.g. 1 ROLL of a given leather = 25 M (base unit)
model ItemUomConversion {
  id           String  @id @default(cuid())
  itemId       String
  item         Item    @relation(fields: [itemId], references: [id], onDelete: Cascade)
  uomCode      String
  factorToBase Decimal @db.Decimal(18, 6)

  @@unique([itemId, uomCode])
}

model Batch {
  id          String    @id @default(cuid())
  itemId      String
  item        Item      @relation(fields: [itemId], references: [id])
  batchNumber String
  receivedAt  DateTime  @default(now())
  supplierId  String?
  unitCost    Decimal?  @db.Decimal(14, 4)
  expiresAt   DateTime?
  remarks     String?
  createdAt   DateTime  @default(now())

  balances     StockBalance[]
  movements    StockMovement[]
  reservations StockReservation[]

  @@unique([itemId, batchNumber])
}

// ───────────────────────────── Inventory ledger ─────────────────────────────

enum InventoryTxType {
  RECEIPT
  ISSUE
  RESERVATION
  RELEASE
  ADJUSTMENT
  TRANSFER
  RETURN
  DAMAGE
  RECONCILIATION
  PRODUCTION_CONSUMPTION
  PRODUCTION_OUTPUT
  PRODUCTION_RETURN
  PURCHASE_RECEIPT
  PURCHASE_RETURN
  QC_DISPOSITION
  SALES_DISPATCH
  REVERSAL
}

enum InventoryTxStatus {
  POSTED
  REVERSED
}

model InventoryTransaction {
  id              String                @id @default(cuid())
  number          String                @unique
  type            InventoryTxType
  status          InventoryTxStatus     @default(POSTED)
  referenceType   String?
  referenceId     String?
  referenceNumber String?
  reason          String?
  remarks         String?
  idempotencyKey  String?               @unique
  requestHash     String?
  createdById     String?
  approvedById    String?
  actorType       ActorType             @default(USER)
  postedAt        DateTime              @default(now())
  reversalOfId    String?               @unique
  reversalOf      InventoryTransaction? @relation("Reversal", fields: [reversalOfId], references: [id])
  reversedBy      InventoryTransaction? @relation("Reversal")
  movements       StockMovement[]

  @@index([type, postedAt])
  @@index([referenceType, referenceId])
  @@index([postedAt])
}

enum StockBucket {
  ON_HAND
  RESERVED
}

/// Immutable ledger line. quantity is signed (+ in / - out) in item base UoM.
model StockMovement {
  id            String               @id @default(cuid())
  transactionId String
  transaction   InventoryTransaction @relation(fields: [transactionId], references: [id])
  itemId        String
  item          Item                 @relation(fields: [itemId], references: [id])
  warehouseId   String
  locationId    String
  location      Location             @relation(fields: [locationId], references: [id])
  batchId       String?
  batch         Batch?               @relation(fields: [batchId], references: [id])
  bucket        StockBucket          @default(ON_HAND)
  quantity      Decimal              @db.Decimal(18, 4)
  unitCost      Decimal?             @db.Decimal(14, 4)
  onHandAfter   Decimal              @db.Decimal(18, 4)
  reservedAfter Decimal              @db.Decimal(18, 4)
  reservationId String?
  createdAt     DateTime             @default(now())

  @@index([itemId, createdAt])
  @@index([locationId])
  @@index([transactionId])
}

/// Cached balance per (item, location, batch). Unique index is NULLS NOT DISTINCT (see migration).
model StockBalance {
  id             String    @id @default(cuid())
  itemId         String
  item           Item      @relation(fields: [itemId], references: [id])
  warehouseId    String
  locationId     String
  location       Location  @relation(fields: [locationId], references: [id])
  batchId        String?
  batch          Batch?    @relation(fields: [batchId], references: [id])
  onHand         Decimal   @default(0) @db.Decimal(18, 4)
  reserved       Decimal   @default(0) @db.Decimal(18, 4)
  lastMovementAt DateTime?
  updatedAt      DateTime  @updatedAt

  @@unique([itemId, locationId, batchId])
  @@index([itemId])
  @@index([warehouseId])
}

enum ReservationStatus {
  ACTIVE
  PARTIALLY_CONSUMED
  CONSUMED
  RELEASED
}

model StockReservation {
  id           String            @id @default(cuid())
  itemId       String
  item         Item              @relation(fields: [itemId], references: [id])
  warehouseId  String
  locationId   String
  location     Location          @relation(fields: [locationId], references: [id])
  batchId      String?
  batch        Batch?            @relation(fields: [batchId], references: [id])
  sourceType   String
  sourceId     String
  sourceLineId String?
  quantity     Decimal           @db.Decimal(18, 4)
  consumedQty  Decimal           @default(0) @db.Decimal(18, 4)
  releasedQty  Decimal           @default(0) @db.Decimal(18, 4)
  status       ReservationStatus @default(ACTIVE)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([sourceType, sourceId])
  @@index([sourceLineId])
  @@index([itemId, status])
}

enum StockCountStatus {
  DRAFT
  SUBMITTED
  POSTED
  CANCELLED
}

model StockCount {
  id            String           @id @default(cuid())
  number        String           @unique
  warehouseId   String
  locationId    String?
  status        StockCountStatus @default(DRAFT)
  remarks       String?
  createdById   String
  submittedAt   DateTime?
  approvedById  String?
  postedAt      DateTime?
  transactionId String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  lines         StockCountLine[]
}

model StockCountLine {
  id         String     @id @default(cuid())
  countId    String
  count      StockCount @relation(fields: [countId], references: [id], onDelete: Cascade)
  itemId     String
  locationId String
  batchId    String?
  systemQty  Decimal    @db.Decimal(18, 4)
  countedQty Decimal?   @db.Decimal(18, 4)
  remarks    String?

  @@unique([countId, itemId, locationId, batchId])
}

// ───────────────────────────── BOM ─────────────────────────────

model Bom {
  id        String       @id @default(cuid())
  code      String       @unique
  itemId    String       @unique
  item      Item         @relation(fields: [itemId], references: [id])
  name      String
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  versions  BomVersion[]
}

enum BomStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

model BomVersion {
  id               String            @id @default(cuid())
  bomId            String
  bom              Bom               @relation(fields: [bomId], references: [id], onDelete: Cascade)
  version          Int
  status           BomStatus         @default(DRAFT)
  /// quantity of finished units the line quantities produce (batch size)
  outputQuantity   Decimal           @default(1) @db.Decimal(18, 4)
  notes            String?
  createdById      String?
  activatedAt      DateTime?
  activatedById    String?
  archivedAt       DateTime?
  copiedFromId     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  lines            BomLine[]
  productionOrders ProductionOrder[]

  @@unique([bomId, version])
}

enum ConsumptionMode {
  BACKFLUSH
  MANUAL
}

model BomLine {
  id                String               @id @default(cuid())
  bomVersionId      String
  bomVersion        BomVersion           @relation(fields: [bomVersionId], references: [id], onDelete: Cascade)
  lineNo            Int
  materialId        String
  material          Item                 @relation(fields: [materialId], references: [id])
  /// constant quantity per outputQuantity (used when formula is empty)
  quantity          Decimal              @db.Decimal(18, 6)
  /// optional formula; variables = SKU attributes + qty
  quantityFormula   String?
  uomCode           String
  wastagePercent    Decimal              @default(0) @db.Decimal(7, 3)
  stageDefinitionId String?
  stageDefinition   StageDefinition?     @relation(fields: [stageDefinitionId], references: [id])
  consumptionMode   ConsumptionMode      @default(BACKFLUSH)
  specifications    String?
  notes             String?
  isOptional        Boolean              @default(false)
  alternatives      BomLineAlternative[]

  @@unique([bomVersionId, lineNo])
}

model BomLineAlternative {
  id               String  @id @default(cuid())
  bomLineId        String
  bomLine          BomLine @relation(fields: [bomLineId], references: [id], onDelete: Cascade)
  materialId       String
  material         Item    @relation(fields: [materialId], references: [id])
  /// quantity multiplier relative to the primary material
  conversionFactor Decimal @default(1) @db.Decimal(18, 6)
  priority         Int     @default(1)
  notes            String?
}

// ───────────────────────────── Manufacturing configuration ─────────────────────────────

model Department {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  workers      Worker[]
  workstations Workstation[]
}

model StageDefinition {
  id              String                 @id @default(cuid())
  code            String                 @unique
  name            String
  description     String?
  defaultSequence Int                    @default(0)
  isQcStage       Boolean                @default(false)
  isActive        Boolean                @default(true)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  routeSteps      RouteStep[]
  bomLines        BomLine[]
  workstations    Workstation[]
  orderStages     ProductionOrderStage[]
}

model Workstation {
  id                String                 @id @default(cuid())
  code              String                 @unique
  name              String
  departmentId      String?
  department        Department?            @relation(fields: [departmentId], references: [id])
  stageDefinitionId String?
  stageDefinition   StageDefinition?       @relation(fields: [stageDefinitionId], references: [id])
  isActive          Boolean                @default(true)
  createdAt         DateTime               @default(now())
  orderStages       ProductionOrderStage[]
}

model Route {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  description String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  steps       RouteStep[]
  items       Item[]
  products    Product[]
}

model RouteStep {
  id                String          @id @default(cuid())
  routeId           String
  route             Route           @relation(fields: [routeId], references: [id], onDelete: Cascade)
  sequence          Int
  stageDefinitionId String
  stageDefinition   StageDefinition @relation(fields: [stageDefinitionId], references: [id])
  workstationId     String?
  instructions      String?

  @@unique([routeId, sequence])
}

// ───────────────────────────── Production ─────────────────────────────

enum ProductionStatus {
  DRAFT
  RELEASED
  MATERIALS_RESERVED
  IN_PROGRESS
  COMPLETED
  CLOSED
  CANCELLED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model ProductionOrder {
  id                String           @id @default(cuid())
  number            String           @unique
  itemId            String
  item              Item             @relation("ProductionOrderItem", fields: [itemId], references: [id])
  bomVersionId      String?
  bomVersion        BomVersion?      @relation(fields: [bomVersionId], references: [id])
  routeId           String?
  warehouseId       String
  outputLocationId  String?
  quantityPlanned   Decimal          @db.Decimal(18, 4)
  quantityCompleted Decimal          @default(0) @db.Decimal(18, 4)
  quantityRejected  Decimal          @default(0) @db.Decimal(18, 4)
  quantityRework    Decimal          @default(0) @db.Decimal(18, 4)
  priority          Priority         @default(NORMAL)
  status            ProductionStatus @default(DRAFT)
  plannedStart      DateTime?
  dueDate           DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  closedAt          DateTime?
  cancelledAt       DateTime?
  cancelReason      String?
  salesOrderLineId  String?
  /// variables used for formula evaluation, frozen at release
  parameters        Json             @default("{}")
  remarks           String?
  createdById       String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  materials   ProductionMaterial[]
  stages      ProductionOrderStage[]
  outputs     ProductionOutput[]
  events      ProductionEvent[]
  inspections QualityInspection[]

  @@index([status, dueDate])
  @@index([itemId])
}

model ProductionMaterial {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  bomLineId         String?
  itemId            String
  item              Item            @relation("ProductionMaterialItem", fields: [itemId], references: [id])
  /// item originally specified on the BOM when a substitute is used
  originalItemId    String?
  stageDefinitionId String?
  consumptionMode   ConsumptionMode @default(BACKFLUSH)
  /// standard quantity per finished unit (without wastage allowance)
  qtyPerUnit        Decimal         @db.Decimal(18, 6)
  wastagePercent    Decimal         @default(0) @db.Decimal(7, 3)
  /// planned requirement including wastage allowance
  requiredQty       Decimal         @db.Decimal(18, 4)
  reservedQty       Decimal         @default(0) @db.Decimal(18, 4)
  consumedQty       Decimal         @default(0) @db.Decimal(18, 4)
  wastageQty        Decimal         @default(0) @db.Decimal(18, 4)
  returnedQty       Decimal         @default(0) @db.Decimal(18, 4)
  uomCode           String

  @@index([productionOrderId])
  @@index([itemId])
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  PAUSED
  COMPLETED
  SKIPPED
  CANCELLED
}

model ProductionOrderStage {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  sequence          Int
  stageDefinitionId String
  stageDefinition   StageDefinition @relation(fields: [stageDefinitionId], references: [id])
  workstationId     String?
  workstation       Workstation?    @relation(fields: [workstationId], references: [id])
  isQcStage         Boolean         @default(false)
  instructions      String?
  status            StageStatus     @default(PENDING)
  qtyGood           Decimal         @default(0) @db.Decimal(18, 4)
  qtyRejected       Decimal         @default(0) @db.Decimal(18, 4)
  qtyRework         Decimal         @default(0) @db.Decimal(18, 4)
  startedAt         DateTime?
  pausedAt          DateTime?
  completedAt       DateTime?
  /// accumulated paused time in seconds
  pausedSeconds     Int             @default(0)
  remarks           String?
  updatedAt         DateTime        @updatedAt

  assignments StageAssignment[]
  outputs     ProductionOutput[]

  @@unique([productionOrderId, sequence])
  @@index([status])
}

model StageAssignment {
  id           String               @id @default(cuid())
  stageId      String
  stage        ProductionOrderStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  workerId     String
  worker       Worker               @relation(fields: [workerId], references: [id])
  assignedById String?
  assignedAt   DateTime             @default(now())

  @@unique([stageId, workerId])
}

/// Production record per stage entry; the source of truth for workforce productivity
model ProductionOutput {
  id                String               @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder      @relation(fields: [productionOrderId], references: [id])
  stageId           String
  stage             ProductionOrderStage @relation(fields: [stageId], references: [id])
  workerId          String?
  worker            Worker?              @relation(fields: [workerId], references: [id])
  qtyGood           Decimal              @db.Decimal(18, 4)
  qtyRejected       Decimal              @default(0) @db.Decimal(18, 4)
  qtyRework         Decimal              @default(0) @db.Decimal(18, 4)
  defectCategoryId  String?
  startedAt         DateTime?
  endedAt           DateTime?
  remarks           String?
  recordedById      String
  recordedAt        DateTime             @default(now())
  idempotencyKey    String?              @unique
  inventoryTxIds    String[]
  /// [{ materialLineId, itemId, quantity }] consumed by this entry (used for exact reversal)
  consumption       Json                 @default("[]")
  inspectionId      String?
  reversedAt        DateTime?
  reversedById      String?
  reversalReason    String?

  @@index([workerId, recordedAt])
  @@index([stageId])
}

model ProductionEvent {
  id                String          @id @default(cuid())
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  stageId           String?
  type              String
  quantity          Decimal?        @db.Decimal(18, 4)
  workerId          String?
  message           String?
  payload           Json?
  createdById       String?
  actorType         ActorType       @default(USER)
  createdAt         DateTime        @default(now())

  @@index([productionOrderId, createdAt])
}

// ───────────────────────────── Workforce ─────────────────────────────

model Worker {
  id           String      @id @default(cuid())
  code         String      @unique
  name         String
  phone        String?
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  jobRole      String?
  /// stage definition codes the worker is skilled in
  skills       String[]
  userId       String?     @unique
  user         User?       @relation(fields: [userId], references: [id])
  joinedOn     DateTime?
  isActive     Boolean     @default(true)
  notes        String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  attendance  Attendance[]
  assignments StageAssignment[]
  outputs     ProductionOutput[]
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
}

model Attendance {
  id           String           @id @default(cuid())
  workerId     String
  worker       Worker           @relation(fields: [workerId], references: [id])
  date         DateTime         @db.Date
  status       AttendanceStatus
  checkIn      DateTime?
  checkOut     DateTime?
  hoursWorked  Decimal?         @db.Decimal(5, 2)
  remarks      String?
  recordedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([workerId, date])
  @@index([date])
}

// ───────────────────────────── Quality ─────────────────────────────

enum QcScope {
  MATERIAL
  PRODUCT
  BOTH
}

model DefectCategory {
  id          String                    @id @default(cuid())
  code        String                    @unique
  name        String
  description String?
  appliesTo   QcScope                   @default(BOTH)
  isActive    Boolean                   @default(true)
  createdAt   DateTime                  @default(now())
  defects     QualityInspectionDefect[]
}

model QcChecklist {
  id          String              @id @default(cuid())
  name        String
  description String?
  appliesTo   QcScope             @default(PRODUCT)
  /// scope to a specific item, product or category (all optional = generic)
  itemId      String?
  productId   String?
  categoryId  String?
  isActive    Boolean             @default(true)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  items       QcChecklistItem[]
  inspections QualityInspection[]
}

enum QcCheckType {
  PASS_FAIL
  NUMERIC
  TEXT
}

model QcChecklistItem {
  id          String      @id @default(cuid())
  checklistId String
  checklist   QcChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  sequence    Int
  label       String
  type        QcCheckType @default(PASS_FAIL)
  minValue    Decimal?    @db.Decimal(14, 4)
  maxValue    Decimal?    @db.Decimal(14, 4)
  unit        String?
  isRequired  Boolean     @default(true)
}

enum InspectionType {
  MATERIAL_RECEIPT
  IN_PROCESS
  FINAL
  RANDOM
}

enum InspectionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model QualityInspection {
  id                 String                    @id @default(cuid())
  number             String                    @unique
  type               InspectionType
  status             InspectionStatus          @default(PENDING)
  itemId             String
  item               Item                      @relation("InspectionItem", fields: [itemId], references: [id])
  productionOrderId  String?
  productionOrder    ProductionOrder?          @relation(fields: [productionOrderId], references: [id])
  productionStageId  String?
  goodsReceiptLineId String?                   @unique
  checklistId        String?
  checklist          QcChecklist?              @relation(fields: [checklistId], references: [id])
  inspectorId        String?
  inspector          User?                     @relation("Inspector", fields: [inspectorId], references: [id])
  quantityInspected  Decimal                   @default(0) @db.Decimal(18, 4)
  quantityAccepted   Decimal                   @default(0) @db.Decimal(18, 4)
  quantityRejected   Decimal                   @default(0) @db.Decimal(18, 4)
  quantityRework     Decimal                   @default(0) @db.Decimal(18, 4)
  remarks            String?
  startedAt          DateTime?
  completedAt        DateTime?
  createdById        String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  results            QualityInspectionResult[]
  defects            QualityInspectionDefect[]

  @@index([status, type])
}

model QualityInspectionResult {
  id              String            @id @default(cuid())
  inspectionId    String
  inspection      QualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checklistItemId String
  passed          Boolean?
  numericValue    Decimal?          @db.Decimal(14, 4)
  textValue       String?
  note            String?

  @@unique([inspectionId, checklistItemId])
}

model QualityInspectionDefect {
  id               String            @id @default(cuid())
  inspectionId     String
  inspection       QualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  defectCategoryId String
  defectCategory   DefectCategory    @relation(fields: [defectCategoryId], references: [id])
  quantity         Decimal           @db.Decimal(18, 4)
  note             String?
}

// ───────────────────────────── Procurement ─────────────────────────────

model Supplier {
  id            String   @id @default(cuid())
  code          String   @unique
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  city          String?
  state         String?
  pincode       String?
  gstin         String?
  paymentTerms  String?
  leadTimeDays  Int?
  notes         String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  contacts       SupplierContact[]
  items          SupplierItem[]
  purchaseOrders PurchaseOrder[]
  goodsReceipts  GoodsReceipt[]
  returns        SupplierReturn[]
}

model SupplierContact {
  id         String   @id @default(cuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  role       String?
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
}

model SupplierItem {
  id               String   @id @default(cuid())
  supplierId       String
  supplier         Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  itemId           String
  item             Item     @relation(fields: [itemId], references: [id])
  supplierSku      String?
  purchaseUomCode  String?
  conversionFactor Decimal  @default(1) @db.Decimal(18, 6)
  lastPrice        Decimal? @db.Decimal(14, 4)
  leadTimeDays     Int?
  minOrderQty      Decimal? @db.Decimal(18, 4)
  isPreferred      Boolean  @default(false)

  @@unique([supplierId, itemId])
}

enum RequisitionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
  CANCELLED
}

model PurchaseRequisition {
  id              String                    @id @default(cuid())
  number          String                    @unique
  status          RequisitionStatus         @default(DRAFT)
  source          String                    @default("MANUAL")
  neededBy        DateTime?
  remarks         String?
  requestedById   String
  approvedById    String?
  approvedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  lines           PurchaseRequisitionLine[]
}

model PurchaseRequisitionLine {
  id                  String              @id @default(cuid())
  requisitionId       String
  requisition         PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)
  itemId              String
  item                Item                @relation("RequisitionLineItem", fields: [itemId], references: [id])
  quantity            Decimal             @db.Decimal(18, 4)
  suggestedSupplierId String?
  remarks             String?
  purchaseOrderLineId String?
}

enum PurchaseOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PARTIALLY_RECEIVED
  RECEIVED
  CLOSED
  CANCELLED
}

model PurchaseOrder {
  id            String              @id @default(cuid())
  number        String              @unique
  supplierId    String
  supplier      Supplier            @relation(fields: [supplierId], references: [id])
  status        PurchaseOrderStatus @default(DRAFT)
  orderDate     DateTime            @default(now())
  expectedDate  DateTime?
  warehouseId   String
  requisitionId String?
  subtotal      Decimal             @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal             @default(0) @db.Decimal(14, 2)
  total         Decimal             @default(0) @db.Decimal(14, 2)
  terms         String?
  remarks       String?
  createdById   String
  submittedAt   DateTime?
  approvedById  String?
  approvedAt    DateTime?
  cancelledAt   DateTime?
  cancelReason  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  lines         PurchaseOrderLine[]
  receipts      GoodsReceipt[]

  @@index([status, expectedDate])
}

model PurchaseOrderLine {
  id               String             @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  lineNo           Int
  itemId           String
  item             Item               @relation("PoLineItem", fields: [itemId], references: [id])
  description      String?
  /// quantity in purchase unit
  quantity         Decimal            @db.Decimal(18, 4)
  uomCode          String
  /// base units per purchase unit
  conversionFactor Decimal            @default(1) @db.Decimal(18, 6)
  unitPrice        Decimal            @db.Decimal(14, 4)
  taxRate          Decimal            @default(0) @db.Decimal(5, 2)
  quantityReceived Decimal            @default(0) @db.Decimal(18, 4)
  quantityRejected Decimal            @default(0) @db.Decimal(18, 4)
  quantityReturned Decimal            @default(0) @db.Decimal(18, 4)
  expectedDate     DateTime?
  grnLines         GoodsReceiptLine[]

  @@unique([purchaseOrderId, lineNo])
  @@index([itemId])
}

enum DocStatus {
  DRAFT
  POSTED
  CANCELLED
}

model GoodsReceipt {
  id                String             @id @default(cuid())
  number            String             @unique
  purchaseOrderId   String?
  purchaseOrder     PurchaseOrder?     @relation(fields: [purchaseOrderId], references: [id])
  supplierId        String
  supplier          Supplier           @relation(fields: [supplierId], references: [id])
  warehouseId       String
  status            DocStatus          @default(POSTED)
  receivedAt        DateTime           @default(now())
  supplierInvoiceNo String?
  supplierChallanNo String?
  vehicleNo         String?
  remarks           String?
  receivedById      String
  inventoryTxId     String?
  idempotencyKey    String?            @unique
  createdAt         DateTime           @default(now())
  lines             GoodsReceiptLine[]
}

model GoodsReceiptLine {
  id                  String             @id @default(cuid())
  goodsReceiptId      String
  goodsReceipt        GoodsReceipt       @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseOrderLineId String?
  purchaseOrderLine   PurchaseOrderLine? @relation(fields: [purchaseOrderLineId], references: [id])
  itemId              String
  item                Item               @relation("GrnLineItem", fields: [itemId], references: [id])
  /// in purchase unit
  quantity            Decimal            @db.Decimal(18, 4)
  uomCode             String
  baseQuantity        Decimal            @db.Decimal(18, 4)
  unitPrice           Decimal?           @db.Decimal(14, 4)
  batchNumber         String?
  batchId             String?
  locationId          String
  requiresInspection  Boolean            @default(false)
  quantityAccepted    Decimal?           @db.Decimal(18, 4)
  quantityRejected    Decimal?           @db.Decimal(18, 4)
}

model SupplierReturn {
  id              String               @id @default(cuid())
  number          String               @unique
  supplierId      String
  supplier        Supplier             @relation(fields: [supplierId], references: [id])
  goodsReceiptId  String?
  purchaseOrderId String?
  warehouseId     String
  status          DocStatus            @default(POSTED)
  reason          String
  remarks         String?
  createdById     String
  inventoryTxId   String?
  idempotencyKey  String?              @unique
  createdAt       DateTime             @default(now())
  lines           SupplierReturnLine[]
}

model SupplierReturnLine {
  id                  String         @id @default(cuid())
  supplierReturnId    String
  supplierReturn      SupplierReturn @relation(fields: [supplierReturnId], references: [id], onDelete: Cascade)
  itemId              String
  item                Item           @relation("SupplierReturnLineItem", fields: [itemId], references: [id])
  locationId          String
  batchId             String?
  quantity            Decimal        @db.Decimal(18, 4)
  purchaseOrderLineId String?
}

// ───────────────────────────── Sales ─────────────────────────────

model CustomerCategory {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  customers Customer[]
}

model Customer {
  id              String            @id @default(cuid())
  code            String            @unique
  companyName     String
  contactPerson   String?
  phone           String?
  email           String?
  billingAddress  String?
  shippingAddress String?
  city            String?
  state           String?
  pincode         String?
  gstin           String?
  categoryId      String?
  category        CustomerCategory? @relation(fields: [categoryId], references: [id])
  paymentTerms    String?
  notes           String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  contacts    CustomerContact[]
  prices      CustomerPrice[]
  inquiries   SalesInquiry[]
  quotations  Quotation[]
  salesOrders SalesOrder[]
  challans    DeliveryChallan[]
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  role       String?
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
}

model CustomerPrice {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  itemId     String
  item       Item      @relation(fields: [itemId], references: [id])
  unitPrice  Decimal   @db.Decimal(14, 2)
  minQty     Decimal   @default(0) @db.Decimal(18, 4)
  validFrom  DateTime?
  validTo    DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, itemId])
}

enum InquiryStatus {
  OPEN
  QUOTED
  WON
  LOST
  CANCELLED
}

model SalesInquiry {
  id           String             @id @default(cuid())
  number       String             @unique
  customerId   String
  customer     Customer           @relation(fields: [customerId], references: [id])
  status       InquiryStatus      @default(OPEN)
  source       String?
  receivedAt   DateTime           @default(now())
  requirements String?
  assignedToId String?
  lostReason   String?
  createdById  String
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  lines        SalesInquiryLine[]
  quotations   Quotation[]
}

model SalesInquiryLine {
  id          String       @id @default(cuid())
  inquiryId   String
  inquiry     SalesInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  itemId      String?
  description String
  quantity    Decimal      @db.Decimal(18, 4)
  targetPrice Decimal?     @db.Decimal(14, 2)
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

model Quotation {
  id            String          @id @default(cuid())
  number        String          @unique
  customerId    String
  customer      Customer        @relation(fields: [customerId], references: [id])
  inquiryId     String?
  inquiry       SalesInquiry?   @relation(fields: [inquiryId], references: [id])
  status        QuotationStatus @default(DRAFT)
  quoteDate     DateTime        @default(now())
  validUntil    DateTime?
  subtotal      Decimal         @default(0) @db.Decimal(14, 2)
  discountTotal Decimal         @default(0) @db.Decimal(14, 2)
  taxTotal      Decimal         @default(0) @db.Decimal(14, 2)
  total         Decimal         @default(0) @db.Decimal(14, 2)
  terms         String?
  notes         String?
  createdById   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  lines         QuotationLine[]
  salesOrders   SalesOrder[]
}

model QuotationLine {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  lineNo      Int
  itemId      String
  item        Item      @relation("QuotationLineItem", fields: [itemId], references: [id])
  description String?
  quantity    Decimal   @db.Decimal(18, 4)
  unitPrice   Decimal   @db.Decimal(14, 2)
  discountPct Decimal   @default(0) @db.Decimal(5, 2)
  taxRate     Decimal   @default(0) @db.Decimal(5, 2)
  lineTotal   Decimal   @db.Decimal(14, 2)
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  PARTIALLY_FULFILLED
  FULFILLED
  CLOSED
  CANCELLED
}

model SalesOrder {
  id               String            @id @default(cuid())
  number           String            @unique
  customerId       String
  customer         Customer          @relation(fields: [customerId], references: [id])
  quotationId      String?
  quotation        Quotation?        @relation(fields: [quotationId], references: [id])
  status           SalesOrderStatus  @default(DRAFT)
  orderDate        DateTime          @default(now())
  requiredBy       DateTime?
  customerPoNumber String?
  warehouseId      String
  subtotal         Decimal           @default(0) @db.Decimal(14, 2)
  discountTotal    Decimal           @default(0) @db.Decimal(14, 2)
  taxTotal         Decimal           @default(0) @db.Decimal(14, 2)
  total            Decimal           @default(0) @db.Decimal(14, 2)
  remarks          String?
  createdById      String
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  cancelReason     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  lines            SalesOrderLine[]
  challans         DeliveryChallan[]

  @@index([status, orderDate])
}

model SalesOrderLine {
  id                String                @id @default(cuid())
  salesOrderId      String
  salesOrder        SalesOrder            @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  lineNo            Int
  itemId            String
  item              Item                  @relation("SoLineItem", fields: [itemId], references: [id])
  description       String?
  quantity          Decimal               @db.Decimal(18, 4)
  unitPrice         Decimal               @db.Decimal(14, 2)
  discountPct       Decimal               @default(0) @db.Decimal(5, 2)
  taxRate           Decimal               @default(0) @db.Decimal(5, 2)
  lineTotal         Decimal               @db.Decimal(14, 2)
  quantityFulfilled Decimal               @default(0) @db.Decimal(18, 4)
  remarks           String?
  challanLines      DeliveryChallanLine[]

  @@unique([salesOrderId, lineNo])
  @@index([itemId])
}

model DeliveryChallan {
  id             String                @id @default(cuid())
  number         String                @unique
  salesOrderId   String
  salesOrder     SalesOrder            @relation(fields: [salesOrderId], references: [id])
  customerId     String
  customer       Customer              @relation(fields: [customerId], references: [id])
  warehouseId    String
  status         DocStatus             @default(DRAFT)
  challanDate    DateTime              @default(now())
  vehicleNo      String?
  transporter    String?
  remarks        String?
  createdById    String
  postedAt       DateTime?
  inventoryTxId  String?
  idempotencyKey String?               @unique
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  lines          DeliveryChallanLine[]
}

model DeliveryChallanLine {
  id               String          @id @default(cuid())
  challanId        String
  challan          DeliveryChallan @relation(fields: [challanId], references: [id], onDelete: Cascade)
  salesOrderLineId String
  salesOrderLine   SalesOrderLine  @relation(fields: [salesOrderLineId], references: [id])
  itemId           String
  item             Item            @relation("ChallanLineItem", fields: [itemId], references: [id])
  locationId       String?
  batchId          String?
  quantity         Decimal         @db.Decimal(18, 4)
}

// ───────────────────────────── Notifications ─────────────────────────────

enum Severity {
  INFO
  SUCCESS
  WARNING
  CRITICAL
}

model Notification {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String
  title      String
  body       String?
  severity   Severity  @default(INFO)
  entityType String?
  entityId   String?
  link       String?
  dedupeKey  String?
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  type     String
  inApp    Boolean @default(true)
  email    Boolean @default(false)
  whatsapp Boolean @default(false)

  @@id([userId, type])
}

// ───────────────────────────── AI Copilot ─────────────────────────────

model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String      @default("New conversation")
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  messages  AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// user | assistant | tool
  role           String
  /// content blocks as sent to / received from the model
  content        Json
  toolName       String?
  inputTokens    Int?
  outputTokens   Int?
  model          String?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

model AiSummary {
  id        String   @id @default(cuid())
  date      DateTime @unique @db.Date
  content   String
  data      Json
  model     String?
  createdAt DateTime @default(now())
}
